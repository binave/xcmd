### Certificate tools
### Usage: cert {selfsign|rsa|ed25519} [OPTION]...
_xlib_cert () {
    case $1 in
        ###   selfsign   create a self-signed certificate
        selfsign)
            # nginx
            shift;
            local host email country="CN" state="BJ" city="BJ" company="ORG" section="dev" days=365;
            while [ "$2" ]; do
                case $1 in
                    ###   -cn, --host=HOST   set the common name (CN)
                    --host|-cn)
                        # Common Name (eg, YOUR name) []:                               /CN             ($IP / $hostname / $alias)
                        host="$2";
                        shift;
                        shift
                    ;;
                    ###   -e, --email=STRING   set the email address
                    --email|-e)
                        # Email Address []:                                             /emailAddress   mail@example.com
                        email="$2";
                        shift;
                        shift
                    ;;
                    ###   -c, --country=STRING   set the country name (C)
                    --country|-c)
                        # Country Name (2 letter code) [AU]:                            /C
                        country="$2";
                        shift;
                        shift
                    ;;
                    ###   -st, --state=STRING   set the state or province name (ST)
                    --state|-st)
                        # State or Province Name (full name) [Some-State]:              /ST
                        state="$2";
                        shift;
                        shift
                    ;;
                    ###   -l, --city=STRING   set the locality name (L)
                    --city|-l)
                        # Locality Name (eg, city) []:                                  /L
                        city="$2";
                        shift;
                        shift
                    ;;
                    ###   -o, --company=STRING   set the organization name (O)
                    --company|-o)
                        # Organization Name (eg, company) [Internet Widgits Pty Ltd]:   /O
                        company="$2";
                        shift;
                        shift
                    ;;
                    ###   -ou, --section=STRING   set the organizational unit name (OU)
                    --section|-ou)
                        # Organizational Unit Name (eg, section) []:                    /OU
                        section="$2";
                        shift;
                        shift
                    ;;
                    ###   --days=NUMBER   set the number of days the certificate is valid
                    --days)
                        days="$2";
                        shift;
                        shift
                    ;;
                    *)
                        exit 1; # Invalid option.
                    ;;
                esac
            done
            [ "$host" ] || exit 1; # Host name is empty.
            [ "$email" ] || exit 1; # Email address is empty.
            local SUBJECT="/C=$country/ST=$state/L=$city/O=$company/OU=$section/CN=$host/emailAddress=$email" \
                SERVER_CERT="./$host/fullchain.pem" \
                SERVER_KEY="./$host/privkey.pem" \
                SERVER_CSR="/tmp/${host}_server.csr" \
                CA_KEY="/tmp/${host}_ca-cert.pem" \
                CA_CERT="./$host/ca.crt";

            mkdir -p "$host";

            # Create the CA.
            openssl genrsa -out $CA_KEY 4096;
            openssl req -new -x509 -days $days -key $CA_KEY -out $CA_CERT -subj "$SUBJECT";

            # Create the server key.
            openssl genrsa -out $SERVER_KEY 4096;

            # Create the server CSR.
            openssl req -new -key $SERVER_KEY -out $SERVER_CSR -subj "$SUBJECT";

            # Self-sign the server CSR.
            openssl x509 -req -days $days -in $SERVER_CSR -CA $CA_CERT -CAkey $CA_KEY -set_serial 01 -out $SERVER_CERT;

        ;;
        ###   rsa[=SUFFIX]   create an RSA key pair, SUFFIX is optional
        rsa)
            shift;
            ssh-keygen -t rsa -P "" -f ~/.ssh/id_rsa$1;
        ;;
        ###   ed25519[=SUFFIX]   create an ed25519 key pair, SUFFIX is optional
        ed25519)
            shift;
            ssh-keygen -t ed25519 -P "" -C "$USER@$HOSTNAME" -f ~/.ssh/id_ed25519$1;
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

