### Connect to a VNC server
### Usage: vnc ADDRESS[:PORT]
_xlib_vnc () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    _xlib_ip --test $1 || exit 1; # Argument is not an IPv4 address.
    open vnc://$1;
    return 0
}

### Start a disposable HTTP server
### Usage: httpd PORT [FILE]
_xlib_httpd () {
    _xlib_inum $1 || exit 1; # Argument is not a port.
    which nc >/dev/null 2>&1 || which ncat >/dev/null 2>&1 || exit 1; # The nc command was not found.
    if [ -s "$2" ]; then
        {
            printf "HTTP/1.1 200 OK\n\n";
            cat "$2";
        } | __httpd_listen $1
    else
        printf "HTTP/1.1 200 OK\n\nNETCAT\n" | __httpd_listen $1

    fi
}

# Listen on a port and print the request; pick the arguments of the local netcat.
__httpd_listen () {
    local port=$1 bin=ncat opt="-l";
    # GNU netcat and busybox need '-l -p PORT'; BSD/OpenBSD netcat takes '-l PORT'.
    which ncat >/dev/null 2>&1 || {
        bin=nc;
        case `nc -h 2>&1` in *GNU*|*[Bb]usy[Bb]ox*) opt="-l -p";; esac
    };
    $bin $opt "$port"
}

### Test whether STRING is a number
### Usage: inum STRING
_xlib_inum () {
    [ "$1" ] || return 2;
    [[ $1 != *[^0-9]* && $1 != 0[0-9]* ]] || return 1;
    return 0
}

### Tag each line with a prefix, supporting the date format
### Usage: COMMAND | prefix [STRFTIME]
_xlib_prefix () {
    [ "$1" ] || exit 1; # Argument is empty.
    source "$(__script_dir)/bash.xlib";
    _prefix "$@"
}

### Plist editor
### Usage: plist [OPTION]... FILE
_xlib_plist () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    # Tools: plutil, defaults, /usr/libexec/PlistBuddy.
    which plutil >/dev/null 2>&1 || xcode-select --install 2>/dev/null
    [ $# -lt 2 ] && exit 1; # Invalid option.
    [ "${2##*.}" == "plist" ] || exit 1; # File format not supported.
    case $1 in
        ###   -g, --get=FILE KEY   print the value of KEY in the plist FILE
        --get|-g)
            shift;
            [ -f "$1" ] || exit 1; # File does not exist.
            [ "$2" ] || exit 1; # Key does not exist.
            # /usr/libexec/PlistBuddy -c "Print :$2" "$1"
            defaults read "$1" "$2"
        ;;
        ###   -x, --xml=FILE   print the plist FILE as XML
        --xml|-x)
            shift;
            [ -f "$1" ] || exit 1; # File does not exist.
            plutil -convert xml1 "$1" -o - || exit 1; # The plutil command failed.
        ;;
        ###   -j, --json=FILE   print the plist FILE as JSON
        --json|-j)
            shift;
            [ -f "$1" ] || exit 1; # File does not exist.
            plutil -convert json -r "$1" -o - || exit 1; # The plutil command failed.
            printf "\n"
        ;;
        ###   -b, --binary=FILE   serialize the plist FILE to stdout
        --binary|-b)
            shift;
            [ -f "$1" ] && exit 1; # File already exists.
            sudo plutil -convert binary1 -o "$1" - || exit 1; # The plutil command failed.
        ;;
        ###   --load=FILE   load the launchd plist FILE
        --load)
            shift;
            [ -f "$1" ] || exit 1; # File does not exist.
            sudo launchctl load -wF "$1"
        ;;
        ###   --unload=FILE   unload the launchd plist FILE
        --unload)
            shift;
            [ -f "$1" ] || exit 1; # File does not exist.
            sudo launchctl unload -w "$1"
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

