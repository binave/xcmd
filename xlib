# The completion kinds of xlib, added to the generic engine in comp.xlib.
__COMP_KINDS="alias mac ipv4 hostip shell kind";

# Map a metavariable of the annotation; the argument is uppercase.
__comp_kind_host () {
    case $1 in
        HOST)        printf 'alias,ipv4';;
        ADDRESS|IP)  printf ipv4;;
        MAC)         printf mac;;
        ALIAS)       printf alias;;
        HOSTIP)      printf hostip;;
    esac
}

# Print the candidates of a kind of xlib; [hosts] ini needs _map of bash.xlib.
# The kind prints its own candidates in order, versions sort as versions.
__comp_value_host () {
    source "$(__script_dir)/bash.xlib";
    local kind=$1 i j ini= version=;
    case $kind in
        alias|mac|hostip) __load_ini hosts;;
    esac
    case $kind in ipv4|hostip) version=-V;; esac
    {
        case $kind in
            alias)
                _map --keys;
                for i in ${MAP2ARRAY[@]}; do printf "%s\n" "$i"; done
            ;;
            mac)
                _map --values;
                for i in ${MAP2ARRAY[@]}; do
                    for j in ${i//|/ }; do
                        [[ ${j//-/:} == *:*:*:*:*:* ]] && printf "%s\n" "$j"
                    done
                done
            ;;
            ipv4)
                __ipv4_list
            ;;
            hostip)
                # An IP in /etc/hosts that is not in the [hosts] ini.
                _map --keys;
                for i in ${MAP2ARRAY[@]}; do ini="$ini $i"; done;
                _map --values;
                for i in ${MAP2ARRAY[@]}; do
                    for j in ${i//|/ }; do ini="$ini $j"; done
                done;
                for i in `awk '{print $1}' /etc/hosts`; do
                    __ipv4_test "$i" || continue;
                    case $i in 0.*|127.*|169.254.*|2[2-5][0-9].*) continue;; esac
                    case " $ini " in *" $i "*) continue;; esac
                    printf "%s\n" "$i"
                done
            ;;
        esac
    } | sort -u $version
}

### Shell completion, auto-generated from annotations
### Usage: comp [OPTION]...
_xlib_comp () {
    source "$(__script_dir)/comp.xlib";
    case $1 in
        ###   -b, --bash   print the bash completion script
        --bash|-b)
            shift;
            __comp_bash "$@"
        ;;
        ###   -z, --zsh   print the zsh completion script
        --zsh|-z)
            shift;
            __comp_zsh "$@"
        ;;
        ###   -i, --install[=SHELL]   install completion to HOME, default is the current shell
        --install|-i)
            shift;
            __comp_install "$@" || exit 1; # Completion installation failed.
        ;;
        ###   -v, --value=KIND   print the candidates of KIND
        --value|-v)
            shift;
            __comp_value "$@"
        ;;
        ###   -l, --list   print the parsed completion metadata
        --list|-l)
            shift;
            __comp_scan | tr ';' '\t'
        ;;
        ###   -c, --check   check annotation and print warnings
        --check|-c)
            shift;
            __comp_check || exit 1 # Annotation warning found.
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

