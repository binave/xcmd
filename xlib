### Show or find IPv4
### Usage: ip [OPTION]... [ARG]...
_xlib_ip () {
    case $1 in
        ###   -l, --list   print the local IPv4 addresses
        --list|-l)
            __ipv4_list
        ;;
        ###   -f, --find=MAC|ALIAS   search for IPv4 by MAC address or hosts alias
        --find|-f)
            shift;
            source "$(__script_dir)/bash.xlib";
            __ip_find "$@"
        ;;
        ###   -t, --test=STRING   test whether STRING is an IPv4 address
        --test|-t)
            shift;
            __ipv4_test "$@"
        ;;
        # Convert a CIDR prefix (e.g., 1.1.1.0/24) to a subnet mask (e.g., 1.1.1.0 255.255.255.0).
        # See https://doc.m0n0.ch/quickstartpc/intro-CIDR.html.
        ###   -c2s, --cidr2subnet=CIDR   convert CIDR to a subnet mask
        --cidr2subnet|-c2s)
            shift;
            [ "$1" ] || exit 1; # Argument is empty.
            set ${1/\// };

            local submask i=0 octets=$(($2 / 8)) \
                sub_octet=$((256 - 2 ** (8 - ($2 % 8) ) ));

            for ((; i < 4; i += 1))
            do
                if [ $i -lt $octets ]; then
                    submask+=".255";

                elif [ $i == $octets ]; then
                    submask+=".$sub_octet";

                else
                    submask+=".0"

                fi
            done
            printf "$1 ${submask:1}"
        ;;
        # Convert a subnet mask (e.g., 1.1.1.0 255.255.255.0) to a CIDR prefix (e.g., 1.1.1.0/24).
        ###   -s2c, --subnet2cidr=ADDRESS MASK   convert a subnet mask to CIDR
        --subnet2cidr|-s2c)
            shift;
            [ "$2" ] || exit 1; # Argument is empty.

            function _exponent() {
                local base=$1 power=2 exponent=0;
                while [ $((base /= $power)) -gt 0 ]; do
                    ((exponent += 1));
                done
                printf $exponent;

            }

            local mask prefix=0
            for mask in ${2//\./ }; do
                (( prefix += 8 - $(_exponent $((256 - $mask))) ))
            done
            printf $1/$prefix
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

# Test whether STR is an IPv4 address.
__ipv4_test () {
    [ "$1" ] || return 1;
    [ ${#1} -gt 15 ] && return 1;
    # Skip an option.
    [ "${1:0:1}" == "-" ] && return 1;
    [[ $1 != *[^.0-9]* && $1 == [1-9]*[0-9] && $1 != *..* ]] || return 1;
    local a IFS=$IFS".";
    a=($1);
    [ ${#a[@]} == 4 ] || return 1;
    for a in ${a[@]}; do
        [ $a -gt 255 ] && return 1;
    done
    return 0
}

# Print local IPv4 addresses by route.
__ipv4_list () {
    # netstat -rn | grep "default"
    local route_ip;
    [[ $OSTYPE == darwin* ]] && {
        route_ip=`route -n get default | awk '/gateway/{print $2}'`;
        ifconfig | awk '/inet '${route_ip%.*}'\.[0-9]+/{print $2}';
        :
    } || {
        # Linux: 'ip' is iproute2, preinstalled on mainstream distributions;
        # 'ifconfig' is the net-tools fallback. POSIX awk only: mawk has no 'gensub'.
        route_ip=`ip route 2>/dev/null | awk '/^default[[:space:]]/{if (NR == 1) print $3}'`;
        [ "$route_ip" ] && ip addr 2>/dev/null | \
            awk -v p="${route_ip%.*}." '$1 == "inet" && index($2, p) == 1 {sub(/\/.*/, "", $2); print $2}' || \
        ifconfig 2>/dev/null | awk '$1 == "inet" {sub(/.*:/, "", $2); if ($2 !~ /^(127\.|169\.254\.)/) print $2}';
        :
    }
}

# Print the ARP (neighbour) entry of an IPv4 address.
__arp_show () {
    [[ $OSTYPE == darwin* ]] && { arp $1 2>/dev/null; return; };
    # 'arp' is net-tools, which is not preinstalled on Linux; prefer iproute2.
    which ip >/dev/null 2>&1 && ip neigh show "$1" 2>/dev/null || \
        arp -n "$1" 2>/dev/null | tr "[:upper:]" "[:lower:]"
}

# Clear the ARP (neighbour) cache.
__arp_flush () {
    [[ $OSTYPE == darwin* ]] && { sudo arp -ad >/dev/null 2>&1; return; };
    which ip >/dev/null 2>&1 && ip neigh flush all >/dev/null 2>&1 || \
        arp -n | awk 'NR>1 {system("arp -d "$1)}' >/dev/null 2>&1
}

# For _xlib_ip.
__ip_find () {
    [ "$1" ] || exit 1; # MAC address or host name is empty.

    # Clear the ARP cache.
    __arp_flush;

    local i j max_len=0 r key mac range route_ip;

    # Get [setting].
    __load_ini sip_setting;
    route_ip=`_map --get route`;
    # arr=(${var//,/ }) is only supported by bash.
    route_ip=(${route_ip//,/ } `[[ $OSTYPE == darwin* ]] && {
        netstat -nr | awk '/^default[[:space:]]/ && ! /tun|tap/ && /([0-9]+\.){3,}/{print $2}';
        :
    } || ip route | awk '/^default/{print $3}'`);
    # Trim the host part of the address.
    for i in ${!route_ip[@]}; do
        _set --add "${route_ip[$i]%.*}" >/dev/null || unset route_ip[$i];
    done
    range=`_map --get range`;
    [ "$range" ] || range="1-127";

    exclude_ip=`_map --get exclude`;
    [ "$exclude_ip" ] && exclude_ip=(${exclude_ip//,/ });
    _map --clear;

    __load_ini hosts;

    local arg mac_addr mac_addr_arr=() tmp;
    for arg in "$@"; do

        # Get from the map.
        mac_addr=`_map --get $arg`;
        mac_addr=${mac_addr:-$arg};

        # Replace the separator; skip a value like 'a-bc'.
        [[ $mac_addr == *-*-*-*-*-* ]] && mac_addr=${mac_addr//-/:};

        [[ $mac_addr == *:*:*:*:*:* ]] && {
            # Cache the maximum variable length.
            [ ${#arg} -gt $max_len ] && max_len=${#arg};
            # Convert to lowercase.
            mac_addr=`_xlib_str --lower $mac_addr`;

            if [[ $OSTYPE == darwin* ]]; then
                # Trim the leading zero: 0a:0b:1c:1d:1e:1f -> a:b:1c:1d:1e:1f.
                tmp="";
                for i in ${mac_addr//|/ }; do
                    [[ $i == *:*:*:*:*:* ]] && \
                    for j in {0..9} {a..f}; do
                        i=${i//0$j/$j}
                    done
                    [ "$tmp" ] && tmp="$tmp|$i" || tmp="$i"
                done
                mac_addr=$tmp;
            fi

            # Add the prefix.
            mac_addr_arr[${#mac_addr_arr[@]}]=$arg@$mac_addr;
        }
    done

    [ ${#mac_addr_arr[@]} == 0 ] && return 0;

    # For the offset.
    max_len=$((max_len / 5 * 5 + 5));

    # fork: Resource temporarily unavailable
    function __match_mac () {
        local i j key t="-W 2";
        # macOS 'ping -t' is a timeout; Linux 'ping -t' is the TTL and the timeout is '-W'.
        [[ $OSTYPE == darwin* ]] && t="-t 2";
        ping -c 2 $t $1 >/dev/null 2>&1;
        j=`__arp_show $1`;
        for mac_addr in ${mac_addr_arr[@]}; do
            # Cache the key.
            key=${mac_addr%%@*};
            # Split the array with '|'.
            mac_addr=(${mac_addr//[@|]/ });
            unset mac_addr[0];
            for i in ${mac_addr[@]}; do
                [[ $j == *$i* ]] && printf "%-${max_len}s$1\n" $key
                # Like nbtstat.
                # [[ `smbutil status $1 2>/dev/null` == *$i* ]] && printf $1
            done
        done
    } 2>/dev/null;

    # Initialize the thread valve.
    _thread_valve --init 32;

    for r in ${route_ip[@]}; do
        for i in `seq ${range/-/ }`; do
            j=true;
            for e in ${exclude_ip[@]}; do [ "${r%.*}.$i" == "$e" ] && j=false; done
            # Get a thread.
            $j && _thread_valve --run __match_mac ${r%.*}.$i
        done
    done

    # Destroy the thread valve.
    _thread_valve --destroy;

    # Print an IPv4 address for each unmatched MAC address.
    for mac_addr in ${mac_addr_arr[@]}; do
        [ "${mac_addr/@/}" == "$mac_addr" -o "${mac_addr/[0-9].[0-9]*.*[0-9].[0-9]/}" == "$mac_addr" ] && continue;
        # Cache the key.
        key=${mac_addr%%@*};
        # Split the array with '|'.
        mac_addr=(${mac_addr//[@|]/ });
        unset mac_addr[0];
        for i in ${mac_addr[@]}; do
            _xlib_ip --test $i && printf "%-${max_len}s$i\n" $key
        done
    done

    # Clear the ARP cache.
    __arp_flush;

}

