### String management
### Usage: str [OPTION]... [STRING]...
_xlib_str () {
    case $1 in
        ###   -l, --lower[=STRING]   convert STRING to lower case
        --lower|-l)
            shift;
            [ "$1" ] && {
                tr "[:upper:]" "[:lower:]" <<< "$@"
            } || tr "[:upper:]" "[:lower:]";
        ;;
        ###   -u, --upper[=STRING]   convert STRING to upper case
        --upper|-u)
            shift;
            [ "$1" ] && {
                tr "[:lower:]" "[:upper:]" <<< "$@";
            } || tr "[:lower:]" "[:upper:]"
        ;;
        ###   -xv, --xmlvalue=TAG   print the values of XML TAG
        --xmlvalue|-xv)
            shift;
            [ "$1" ] || exit 1; # Argument is empty.
            # grep -oP '(?<=\>)[\d\w_]+(?=\<\/'$1')' && return 0;
            perl -ne 'STDOUT->autoflush; print m/(?<=\>)[\d\w_]+(?=\<\/'"$1"')/g, "\n"' && return 0;
            return 1
        ;;
        ###   --tac[=FILE]   print FILE in reverse
        --tac)
            shift;
            if which perl >/dev/null; then
                [ "$1" ] && {
                    perl -e 'print reverse <>' "$1"
                    :
                } || perl -e 'print reverse <>'
            else
                [ "$1" ] && {
                    sed '1!G;h;$!d' "$1"
                    :
                } || sed '1!G;h;$!d'
            fi
        ;;
        # --xmltrim|-xt)
        #     # -xt [text_file_path] Get XML without annotations.
        #     shift;
        #     awk '/<!--/{i++}/-->/{i--}!i&&!/-->/&&!/^$/' "$@"
        # ;;
        # --spacetrim|-st)
        #     -st [text_file_path]  Replace all spaces with one space.
        #     shift;
        #     [ -f "$1" ] || exit 1; # File not found.
        #     [ "`uname`" == "Linux" ] && {
        #         sed -r ':1;N;$!b1;s/\s+/ /g' "$1"
        #         :
        #     } || perl -i -pe 's/\s+/ /g' "$1"
        # ;;
        ###   -ua, --unascii=PATH   print text that is not ASCII in PATH
        --unascii|-ua)
            shift;
            if [ -d "$1" ]; then
                grep -r '[^[:alnum:][:punct:][:space:]]' "$1";
            elif [ -f "$1" ]; then
                grep '[^[:alnum:][:punct:][:space:]]' "$1";
            else
                grep '[^[:alnum:][:punct:][:space:]]'
            fi
        ;;
        ###   -n, --now   print the current time as YYYYmmddHHMMSS
        --now|-n)
            date +%Y%m%d%H%M%S
        ;;
        ###   -r, --random[=NUMBER]   print a random string of NUMBER characters
        --random|-r)
            shift;
            # local rand=`dd if=/dev/random bs=1 count=${1:-32} 2>/dev/null | base64 | tr -d '\n'`; # tr -d '\n' support linux
            openssl rand -base64 ${1:-9} | tr -d '\n' | sed "s/[^0-9A-Za-z]/${RANDOM:0:1}/g"
        ;;
        ###   -U, --uuid   print a UUID
        --uuid|-U)
            # macOS ships 'uuidgen'; the Linux kernel exposes one without a package.
            [[ $OSTYPE == darwin* ]] && uuidgen || cat /proc/sys/kernel/random/uuid
        ;;
        ###   -t, --dhms=SECONDS   format SECONDS as Nd Nh Nm Ns
        --dhms|-t)
            shift;
            _xlib_inum $1 || exit 1; # Not a number.
            local out=$(($1 % 60))s;
            [ $1 -ge 60 ] && {
                out=$(($1 % 3600 / 60))m\ $out;
                [ $1 -ge 3600 ] && {
                    out=$(($1 % 86400 / 3600))h\ $out;
                    [ $1 -ge 86400 ] && out=$(($1 / 86400))d\ $out
                }
            };
            printf "$out\n"
        ;;
        ###   -pw, --passwd=STRING   print the crypt hash of STRING
        --passwd|-pw)
            shift;
            which openssl >/dev/null 2>&1 || exit 1; # The openssl command was not found.
            [ "$1" ] || exit 1; # Argument is empty.
            openssl passwd -1 "$1"
        ;;
        ###   -lcs=STRING STRING   print the longest common subsequence
        -lcs)
            source "$(__script_dir)/bash.xlib";
            _lcs "$2" "$3"
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

### Show CPU times
