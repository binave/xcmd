### Directory tools
### Usage: dir [OPTION]... [ARG]...
_xlib_dir () {
    case $1 in
        ###   -uh, --unhidden=DIRECTORY   clear the hidden flag on all entries in DIRECTORY
        --unhidden|-uh)
            shift;
            [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
            [ -d "$1" ] || exit 1; # Target not found or not a directory.
            chflags nohidden "$1"/*;
            sudo spctl --master-disable;
        ;;
        ###   -lcdi, --list-container-data-info   print container metadata
        --list-container-data-info|-lcdi)
            # TODO: OSTYPE?
            local i;
            for i in ~/Library/Containers/*-*-????-*-*; do
                printf '%s # %s\n' "$i" $(
                    defaults read "$i"/.com.apple.containermanagerd.metadata.plist MCMMetadataIdentifier
                );
            done | sort -k 2
        ;;
        ###   --own=DIRECTORY   set the owner of DIRECTORY to the second argument, default 'bin'
        --own)
            shift;
            [ -d "$1" ] || exit 1; # Directory not found.
            local USER arg;
            USER=${2:-bin};
            # ${1:(-1)} == ${1:0-1}
            [ ${1:(-1)} == / ] && arg="${1:0:${#1}-1}" || arg="$1";
            sudo chown -R $USER:`id -gn $USER` "$arg" || return 1;
            sudo chmod -R 644 "$arg/*"
            sudo find "$arg" -type d -exec chmod 755 {} \;
        ;;
        ###   --boot=DIRECTORY   rebuild the boot file in DIRECTORY
        --boot)
            [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
            shift;
            [ -f "$1/com.apple.recovery.boot/kernelcache" ] || exit 1; # Boot file not found.
            sudo bless --folder "$1/com.apple.recovery.boot" --label "Recovery HD";
            # 426F6F74-0000-11AA-AA11-00306543ECAC
            # [ "${1##*/}" == "dmtest" -a "${2##*/}" == "BaseSystem.dmg" -a -d "$3" ] && "$2" ensureRecoveryPartition "$3" "$2" 0 0 "${2%.*}.chunklist"
        ;;
        ###   -c, --count[=DIRECTORY]   count files in DIRECTORY, default is the current directory
        --count|-c)
            shift;
            [ "$1" ] && {
                [ -d "$1" ] || exit 1; # Target not found or not a directory.
                :
            } || set -- \.;
            # ls -alR "$1" 2>/dev/null | grep -c '^-'
            find "$1" -type f | grep -c '/'
        ;;
        ###   -u, --unique[=DIRECTORY]   search for duplicate files in DIRECTORY
        --unique|-u)
            [[ $OSTYPE == darwin* ]] && exit 1; # Not supported on macOS (OS X).
            shift;
            # TODO
            local i pi size path1 sum name1 temp tmp path_arr=() name_arr=() out=".#Trash";
            touch "$out.log" || exit 1; # Output error.
            mkdir -p "$out";
            while read size path1; do
                [ "$temp" == "$size" ] || {
                    [ ${#path_arr[@]} -gt 1 ] && \
                    while read sum name1; do
                        [ "$sum" ] && printf "${sum:0:8},${name1//%/%%}\n";
                        [ "$tmp" == "$sum" ] || {
                            [ ${#name_arr[@]} -gt 1 ] && {

                                # Save the first file.
                                unset name_arr[0];
                                for pi in ${!name_arr[@]}; do
                                    pi="${name_arr[$pi]}";
                                    printf "$temp,MOVE ";
                                    # Move the file to the new file.
                                    if [ "$pi" == "${pi%/*}" ]; then
                                        mv -v "./$pi" "$out"
                                    else
                                        mkdir -p "$out/${pi%/*}";
                                        mv -v "./$pi" "$out/${pi%/*}"
                                    fi
                                done

                                printf "\n"
                            };

                            # Sync status.
                            tmp="$sum";
                            name_arr=()
                        };
                        [ -f "$name1" ] && name_arr[${#name_arr[@]}]="$name1"
                    done < <(
                        {
                            for i in ${!path_arr[@]}; do
                                sha256sum "${path_arr[$i]}" &
                            done
                            wait
                        } | sort --key=1 | uniq --all-repeated --check-chars=64;
                        printf "\n";
                    );

                    # Sync status.
                    temp="$size";
                    path_arr=()
                };
                [ -f "$path1" ] && path_arr[${#path_arr[@]}]="${path1#*./}";
            done < <(
                find "${@:-.}" -not -empty -type f -not -iregex ".*$out.*" -printf "%s            %p\n" | \
                    sort --key=1 | \
                    uniq --all-repeated --check-chars=12;
                printf "\n";
            ) 2>&1 | tee -a $out.log;

        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

