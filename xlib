# Resolve the real script directory, follow symlink
__script_dir () {
    [ "$__SELF_DIR" ] && { printf "%s" "$__SELF_DIR"; return; }
    local src=$0 dir;
    while [ -L "$src" ]; do
        dir=$(cd "$(dirname "$src")" && pwd);
        src=$(readlink "$src");
        case $src in /*) :;; *) src="$dir/$src";; esac
    done
    cd "$(dirname "$src")" && pwd
}
__SELF_DIR=$(__script_dir)

# Framework:
#
#     A function whose name conforms to the specification gets:
#         External invocation.
#         Error handling.
#         Help information.
#         The function list.
#         Shell completion.
#
#     The annotation is both the help text and the completion source; keep it next to the code:
#         A [###] at the line start is for the command; an indented [###] is for the case pattern below it.
#
#     For example:
#         ### [brief_introduction]
#         ### Usage: [function_name] [OPTION]... [OPERAND]...
#         [script_name]_[function_name](){
#             [function_body]
#             case $1 in
#                 ###   -o, --option=FILE   [description]
#                 --option|-o)
#                     [function_body]
#                 ;;
#                 ###   OPERAND=FILE   [description]
#                 *)
#                     [function_body]
#                 ;;
#             esac
#             # exit and display [error_description]
#             exit 1; # [error_description]
#         }
#
#     The metavariable names the completion source:
#         FILE IMAGE DIRECTORY DEVICE PATH HOST ADDRESS MAC ALIAS HOSTIP SHELL KIND
#         {a|b} is an enumeration, e.g., {yes|no}
#         The kinds of this host are declared by __COMP_KINDS, __comp_kind_host and
#         __comp_value_host; the generic engine lives in comp.xlib.
#
#     [###] is reserved for annotation; any other comment must use [#]:
#         Use [comp --check] to check the annotations.

### Print version and exit
### Usage: version
_xlib_version () {
    printf "0.26.9.26\n" >&2;
    return 0
}

### Control the cursor
### Usage: cur [OPTION]
_xlib_cur () {
    case $1 in
        ###   -, --hide   hide the cursor
        --hide|-)
            printf '\033[?25l'
            # trap 'printf "\033[?25h"; exit' INT; # Show the cursor after Ctrl-C.
        ;;
        ###   +, --show   show the cursor
        --show|+)
            printf '\033[?25h'
        ;;
        "")
            local p=;
            printf '\e[6n';
            read -sdR p;
            printf "${p#*[}\n"
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

### Create or convert a package file
### Usage: pkg [OPTION]... [PATH]
_xlib_pkg () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    local tmp;
    case $1 in
        ###   -n, --dmg=DIRECTORY   create a DMG from a DIRECTORY
        --dmg|-n)
            shift;
            [ -d "$1" ] || exit 1; # Target directory not found.
            # Trim: # linux:${1:0:-1} -> darwin:${1:0:${#1}-1}
            [ "${1:0-1}" == "/" ] && tmp="${1:0:${#1}-1}" || tmp="$1";
            tmp=${tmp##*/};
            hdiutil create -srcfolder "$1" -skipunreadable -format UDZO "$tmp.dmg" || return 1
        ;;
        ###   -t, --verify=FILE   verify a DMG FILE
        --verify|-t)
            shift;
            [ "${1##*.}" == "dmg" -o "${1##*.}" == "DMG" ] || exit 1; # Invalid format.
            hdiutil verify "$1"
        ;;
        ###   -di, --dmg2iso=FILE   convert a DMG FILE to ISO
        --dmg2iso|-di)
            shift;
            [ -f "$1" ] || exit 1; # DMG file not found.
            [ "${1##*.}" == "dmg" -o "${1##*.}" == "DMG" ] || exit 1; # Not a DMG file.
            tmp=${1##*/};
            tmp=${tmp%.*};
            hdiutil convert "$1" -format UDTO -o "$tmp.iso";
        ;;
        ###   -id, --iso2dmg=FILE   convert an ISO FILE to DMG
        --iso2dmg|-id)
            shift;
            [ -f "$1" ] || exit 1; # ISO file not found.
            [ "${1##*.}" == "iso" -o "${1##*.}" == "ISO" ] || exit 1; # Not an ISO file.
            tmp=${1##*/};
            tmp=${tmp%.*};
            hdiutil convert "$1" -format UDRW -o "$tmp.dmg";
        ;;
        ###   -u, --udf=DIRECTORY   create an ISO from a DIRECTORY
        --udf|-u)
            shift;
            [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
            [ -d "$1" ] || exit 1; # Directory not found.
            # hdiutil makehybrid -iso -joliet -o win8.iso win8.cdr
            hdiutil makehybrid -udf -udf-version 1.02 -o "$1.iso" "$1";
            return 0
        ;;
        ###   -w, --dd=IMAGE|DEVICE   write IMAGE to DEVICE, e.g., /dev/disk2
        --dd|-w)
            shift;
            # caller 0;
            [ -f "$1" ] || exit 1; # Image file not found.
            local target i j k l;
            [ "${2:0:9}" == "/dev/disk" ] && {
                target=$2
            } || {
                # Cut the mount info.
                while read i j k; do
                    [ "${k%% (*}" == "$2" ] && target=$i
                done < <(mount)
            }
            # Trim the slice suffix.
            [[ $target == *disk[0-9]s[0-9] ]] && target=${target%s*};

            case ${1##*.} in
                img)
                    diskutil unmountDisk $target >/dev/null || exit 1; # Cannot unmount this disk.
                    sudo dd if="$1" of=$target bs=4m || exit 1; # The dd command failed.
                ;;
                iso)
                    diskutil unmountDisk $target >/dev/null || exit 1; # Cannot unmount this disk.
                    hdiutil convert "$1" -format UDRW -o "${1%.*}.dmg" >/dev/null;
                    sudo dd if="${1%.*}.dmg" of=$target bs=4m || exit 1; # The dd command failed.
                    rm "${1%.*}.dmg";
                    # sudo dd if="${1%.*}.dmg" of=$target bs=4m & while killall -USR1 dd; do
                    #     sleep 10;
                    # done | _xlib_prefix "%F %T, "
                ;;
                gz)
                    which gzcat >/dev/null 2>&1 || exit 1; # The gzcat command was not found.
                    diskutil unmountDisk $target >/dev/null || exit 1; # Cannot unmount this disk.
                    gzcat "$1" | sudo dd of=$target bs=4m || exit 1; # The dd command failed.
                ;;
                xz)
                    which xzcat >/dev/null 2>&1 || exit 1; # The xzcat command was not found; try 'brew install xz'.
                    diskutil unmountDisk $target >/dev/null || exit 1; # Cannot unmount this disk.
                    xzcat "$1" | sudo dd of=$target bs=4m || exit 1; # The dd command failed.
                ;;
                *)
                    exit 1; # Format not supported.
                ;;
            esac

            sync;
            diskutil eject $target >/dev/null
            return 0
        ;;
        ###   -g, --get[=NUMBER]   get an APK file from the AppStore; NUMBER is the countdown in minutes
        --get|-g)
            [[ ${OSTYPE/darwin/} > 24.9 ]] && {
                printf "\033[31mError: OS version too new.\033[0m\n" >&2;
                return 1
            }
            __get_pkg $2
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

# Get an APK file from the AppStore.
__get_pkg () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    # sudo chown -R $USER:`id -gn $USER` /private/var/folders
    # sudo chmod -R 755 /private/var/folders
    [ `ps -ef | grep -c "${0##*/}.*pkg.*-g"` -gt 3 ] && exit 1; # The pkg command is already running.

    # Override the pkg map: pkg[$serial_number]="$path".
    function ___get_pkg_serial_number () {
        local k v;
        while read k v; do
            # Put it in the map.
            [ "$v" ] && pkg[$k]="$v";
        done < <(find "$1" -type f -iname "*.pkg" -exec ls -i {} \; 2>/dev/null); # *.tmp *.pkg
        return 0
    };

    # Hash the file and move it to ~/Downloads.
    function ___get_pkg_complete () {
        [ -f "$1" ] || return 1;
        local name=${1##*/};
        name=${name#*_};
        name=${name%.*};

        {
            printf "NAME: ${1##*/}\n";
            printf "SIZE: ";
            du -h "$1" | awk '{print $1}'
            printf "TIME: ";
            _xlib_str --dhms $(($(date +%s) - $sec_on));
            _xlib_hash "$1"
            mv "$1" ~/Downloads 2>/dev/null || {
                cp "$1" ~/Downloads && printf "\033[31m$1 still exist\033[0m\n"
            }
        } | awk -v name="${name:0:8}, " '{print name $0; fflush(stdout)}'

    };

    local i anchor count_cache=0 pkg=() tmp=/private/var/tmp store_agent countdown=$((${1-1} * 60 * 5)) sec_on=$(date +%s);

    {

        printf -v store_agent /private/var/folders/*/*/C/com.apple.appstoreagent/com.apple.appstore;
        printf "Will listen \033[4m%s\033[0m sec.\n" $(($countdown / 5));

        # Register a hard link from /private/var/tmp.
        ___get_pkg_serial_number "$store_agent";

        # Infinite loop.
        while :; do

            # Exit when all downloads are complete.
            [ $countdown -lt 0 -a ${#pkg[@]} == 0 ] && {
                printf "Exit.\n";
                break
            };

            [ $((countdown -= 1)) == 0 ] && printf "Listening \033[4mstop\033[0m.\n";

            # Search for the downloaded package.
            ___get_pkg_serial_number "$store_agent";

            # Iterate over the package array.
            [ ${#pkg[@]} -gt 0 ] && for i in ${!pkg[@]}; do
                # Already complete.
                [ "${pkg[$i]%/*}" == "$tmp" ] && {
                    ___get_pkg_complete "${pkg[$i]}" &
                    unset pkg[$i];
                    continue
                };

                anchor=$tmp/${i}_${pkg[$i]##*/}; # Anchor file path.

                # Add a hard link.
                [ -f "$anchor" ] || {
                    ln "${pkg[$i]}" "$anchor" && printf "Add \033[4m${pkg[i]##*/}\033[0m.\n";
                };

                # The download is complete.
                [ -f "${pkg[$i]}" ] || {
                    unset pkg[$i];
                    ___get_pkg_complete "$anchor" &
                };
            done;

            [ ${count_cache} != ${#pkg[@]} ] && {
                printf "Count: ${#pkg[@]}\n";
                count_cache=${#pkg[@]}
            };

            sleep 0.2
        done;

    } | _xlib_prefix "%F %T, GPKG, "

    # Wait for all threads to finish.
    wait
}

### Wake on LAN
### Usage: wol [OPTION]... TARGET
_xlib_wol () {
    [ "$1" ] || exit 1; # MAC address is empty.

    source "$(__script_dir)/bash.xlib";

    # Load the [hosts] ini config into map0.
    __load_ini hosts;

    local i j mac_addr broadcast route_ip mac_arr=();
    case $1 in
        ###   -b, --broadcast=ADDRESS|ALIAS   broadcast ADDRESS for all targets
        --broadcast|-b)
            shift;
            # Resolve the broadcast address from an IPv4 address or host alias.
            for i in `__wol_addr "$1"`; do
                _xlib_ip --test "$i" && { broadcast=$i; break; }
            done
            [ "$broadcast" ] || exit 1; # Cannot resolve the broadcast IPv4 address.
            shift
        ;;
        ###   TARGET=ALIAS|HOSTIP   MAC address, hosts alias or IPv4 address
        *)
            # Default broadcast address: the same subnet as the default gateway.
            [[ $OSTYPE == darwin* ]] && \
                route_ip=`route -n get default 2>/dev/null | awk '/gateway/{print $2}'` || \
                route_ip=`ip route 2>/dev/null | awk '/^default[[:space:]]/{if (NR == 1) print $3}'`;
            [ "$route_ip" ] || exit 1; # Cannot resolve the broadcast IPv4 address.
            broadcast="${route_ip%.*}.255"
        ;;
    esac

    [ "$1" ] || exit 1; # MAC address is empty.

    # Resolve all MAC addresses from a MAC address, host alias or IPv4 address.
    for i in "$@"; do
        mac_addr=;
        for j in `__wol_addr "$i"`; do
            [[ ${j//-/:} == *:*:*:*:*:* ]] || continue;
            mac_addr=true;
            mac_arr[${#mac_arr[@]}]=$j;
        done
        [ "$mac_addr" ] || exit 1; # Cannot resolve the MAC address.
    done

    # Wake each MAC address.
    for i in ${mac_arr[@]}; do
        __wol "$i" "$broadcast";
    done

}

# Print MAC addresses and IPv4 addresses for the [hosts] ini, from a MAC address,
#   host alias or IPv4 address.  Read the ini config from HOME or the script path,
#   and reverse lookup in /etc/hosts.
# Usage: __wol_addr [STRING]
__wol_addr () {
    [ "$1" ] || return 1;
    local i j k line;
    # By MAC address or host alias.
    line=`_map --get "$1"`;
    line=${line:-$1};

    # By IPv4 address.
    if _xlib_ip --test "$1"; then
        # Reverse lookup the host alias in map0.
        if [ "$line" == "$1" ]; then
            _map --keys;
            for i in ${MAP2ARRAY[@]}; do
                j=`_map --get "$i"`;
                for k in ${j//|/ }; do
                    [ "$k" == "$1" ] && { line=$j; break 2; }
                done
            done
        fi

        # Reverse lookup the host name in /etc/hosts, which the [hosts] command updates.
        if [ "$line" == "$1" ]; then
            for i in `awk -v ip="$1" '$1 == ip {for (n = 2; n <= NF; n++) print $n}' /etc/hosts`; do
                j=`_map --get "$i"`;
                [ "$j" ] && { line=$j; break; }
            done
        fi
    fi

    # Print the MAC address and IPv4 address.
    local addr IFS=$IFS"|";
    addr=($line);
    IFS=${IFS%|};
    for i in ${addr[@]}; do
        _xlib_ip --test "$i" && { printf "%s\n" "$i"; continue; }
        [[ ${i//-/:} == *:*:*:*:*:* ]] && printf "%s\n" "$i"
    done

    return 0
}

__wol () {
    if which perl >/dev/null && [ "${SHELL##*/}" == "bash" -o "${SHELL##*/}" == "zsh" ]; then
        printf $(
            {
                printf 'f%.0s' {1..12};
                printf "${1//[:-]/}%.0s" {1..16};
            } | sed 's/../\\x&/g'
        ) | perl -ne 'use Socket; socket(S, AF_INET, SOCK_DGRAM, getprotobyname("udp")); setsockopt(S, SOL_SOCKET, SO_BROADCAST, 1); send(S, $_, 0, pack_sockaddr_in(9, inet_aton("'"$2"'"))); close S' || \
            exit 1; # The perl command failed.

    elif which python >/dev/null; then
        python -c 'import socket; S=socket.socket(socket.AF_INET, socket.SOCK_DGRAM); S.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1); S.sendto("".join(["F" * 12, "'"$1"'".replace(":", "").replace("-", "") * 16]).decode("hex"), ("'"$2"'", 9))' || \
            exit 1; # The python command failed.

    else
        exit 1; # Not supported.

    fi

}

### Remote tools
### Usage: remote [OPTION]... [ARG]...
_xlib_remote () {
    case $1 in
        ###   -ed25519=HOST   copy the ed25519 public key to HOST; an optional ALIAS suffix may be given
        -ed25519)
            shift;
            __remote_ed25519 "$@"
        ;;
        ###   -scp=PASSWORD COMMAND...   copy files over scp with PASSWORD
        -scp)
            shift;
            __remote_auto_scp "$@"
        ;;
        ###   -tar=PATH   transfer PATH by tar, the first ARG is a tar option
        -tar)
            shift;
            __remote_tar "$@"
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

# For _xlib_remote.
__remote_ed25519 () {
     [ "$1" ] || exit 1; # First argument is empty.
    local ed25519_pub;
    [ -s ~/.ssh/id_ed25519$2.pub ] || ssh-keygen -t ed25519 -P "" -f ~/.ssh/id_ed25519$2;
    printf %s 'mkdir ~/.ssh 2>/dev/null;
printf %s "'`cat ~/.ssh/id_ed25519$2.pub 2>/dev/null`'" >> ~/.ssh/authorized_keys;
chmod 600 ~/.ssh/authorized_keys;
chmod 700 ~/.ssh
' | ssh $1 bash || exit 1; # Unknown error.

    local host=${1#*@} user;
    [ "$host" == "$1" ] && user=${1%@*} || user=$USER;

    printf %s "Host    $host
    HostName        $host
    Port            22
    User            $user
    IdentityFile    ~/.ssh/id_ed25519$2
"
    return 0
}

# For _xlib_remote.
__remote_auto_scp () {
    local password;
    which expect >/dev/null 2>&1 || exit 1; # The expect command was not found.
    password=$1;
    shift;
    expect <<-TCL
	set timeout 150
	spawn scp $*
	expect {
		timeout { exit 2 }
		"*yes/no" { send "yes\r"; exp_continue }
		"*assword:" { send "$password\r" }
	}
	expect {
		timeout { exit 2 }
		"*denied*" { exit 3 }
		"No such" { exit 4 }

####        "100%" { exit 0 }

    }
	expect eof
	TCL

    case $? in
        1)
            exit 1; # Expect error.
        ;;
        2)
            exit 1; # Timed out.
        ;;
        3)
            exit 1; # Password error.
        ;;
        4)
            exit 1; # File not found.
        ;;
        *)
            exit 1; # Unknown error.
        ;;
    esac
}

__remote_tar () {
    [ "$1" ] || exit 1; # Target URL is empty.
    [ "$2" ] || exit 1; # Source URL is empty.
    local option="$1" target_host target_dir source_host source_dir;
    shift;

    target_dir="${1#*:}";
    [ "$target_dir" == "$1" ] || target_host=${1%%:*};
    # ${target_dir:(-1)} == ${target_dir:0-1}
    [ "${target_dir:0-1}" == "/" ] && target_dir="${target_dir:0:${#target_dir}-1}"

    source_dir="${2#*:}";
    [ "$source_dir" == "$2" ] || source_host=${2%%:*};
    [ "${source_dir:0-1}" == "/" ] && source_dir="${source_dir:0:${#source_dir}-1}"

    # echo $target_host, $target_dir, $source_host, $source_dir
    # return 0

    function ___tar_c () {
        {
            [ "${option/P/}" == "$option" ] && \
            printf %s 'cd "'"${2%/*}"'" >/dev/null && tar '$option' - "'"${2##*/}"'"' || \
            printf %s 'tar '$option' - "'"$2"'"'
        } | ssh $1 bash
    };

    function ___tar_x () {
        [ "${option/P/}" == "$option" ] && {
            ssh $1 'cd "'"$2"'" >/dev/null && tar '$option' -'
        } || ssh $1 'tar '$option' - '
    };

    function ___tar_cat_i () {
        ssh $1 'cat > "'"$2"'"'
    };

    function ___tar_cat_o () {
        ssh $1 'cat "'"$2"'"'
    };

    case $option in
        *c*)
            if [ "$target_host" -a "$source_host" ]; then
                # Both sides are remote.
                ___tar_c $source_host "${source_dir}" | ___tar_cat_i $target_host "$target_dir"
            elif [ "$target_host" ]; then
                # Local to remote.
                [ -d "$source_dir" ] || exit 1; # source path not found.
                {
                    [ "${option/P/}" == "$option" ] && {
                        cd "${source_dir%/*}" >/dev/null && tar $option - "${source_dir##*/}"
                        cd "$OLDPWD"
                        :
                    } || tar $option - "${source_dir}"
                } | rcat $target_host "$target_dir";
            else
                # Remote to local.
                ___tar_c $source_host "$source_dir" > "$target_dir";
            fi
        ;;
        *x*)
            if [ "$target_host" -a "$source_host" ]; then
                # Both sides are remote.
                ___tar_cat_o $source_host "${source_dir}" | ___tar_x $target_host "$target_dir"
            elif [ "$target_host" ]; then
                # Local to remote.
                [ -f "$source_dir" ] || exit 1; # source file not found.
                cat "$source_dir" | ___tar_x $target_host "$target_dir"
            else
                # Remote to local.
                cd "$target_dir";
                ___tar_cat_o $source_host "$source_dir" | tar $option -;
                cd "$OLDPWD"
            fi
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac

    return 0
}

### Operating system settings, macOS only
### Usage: oset [OPTION]... [ARG]...
_xlib_oset () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    case $1 in
        ###   -v, --version   print the OS version
        --version|-v)
            which sw_vers >/dev/null 2>&1 && {
                sw_vers | awk '{if(/ProductVersion/) {printf $2}; if(/BuildVersion/) print "." $2}';
                :
            } || system_profiler SPSoftwareDataType | \
                awk '/System Version/{gsub(/[()]/, "", $5); print $4 "." $5}'
        ;;
        ###   -a, --allow   allow installation of all apps
        --allow|-a)
            sudo spctl --master-disable;
        ;;
        ###   -aa, --allow-app=FILE   allow running the app bundle FILE
        --allow-app|-aa)
            shift;
            [ -e "$1" ] || exit 1; # App bundle not set or not found.
            sudo spctl --master-disable;
            sudo xattr -r -d com.apple.quarantine "$1"
        ;;
        ###   -, --hidden={yes|no}   show or hide private files and directories
        --hidden|-)
            shift;
            [ "$1" == "yes" -o "$1" == "no" ] || exit 1; # The value must be 'yes' or 'no'.
            defaults write com.apple.finder AppleShowAllFiles $1;
        ;;
        ###   -rl, --re-launch   reset LaunchPad
        --re-launch|-rl)
            defaults write com.apple.dock ResetLaunchPad -bool true;
            killall Dock
        ;;
        ###   -sl, --set-launch=NUMBER   set the LaunchPad ROWS and COLUMNS
        --set-launch|-sl)
            shift;
            if [ "$2" ]; then
                defaults write com.apple.dock springboard-rows -int $1
                defaults write com.apple.dock springboard-columns -int $2
                killall Dock
            elif [ "$1" ]; then
                exit 1; # Columns not set.
            else
                defaults write com.apple.dock springboard-rows Default
                defaults write com.apple.dock springboard-columns Default
                killall Dock
            fi
        ;;
        ###   -u, --uuid[=USER]   print the UUID of USER, default is the current user
        --uuid|-u)
            shift;
            [ "$1" ] || set "" $USER;
            dsmemberutil getuuid -U $1
        ;;
        ###   -s, --sid[=USER]   print the SID of USER, default is the current user
        --sid|-s)
            shift;
            [ "$1" ] || set "" $USER;
            dsmemberutil getsid -U $1
        ;;
        ###   -l, --lock-screen   lock the screen
        --lock-screen|-l)
            # Ctrl + Command + Q
            /System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend
        ;;
        ###   --ms, --mobile-sync   open the MobileSync backup DIRECTORY
        --mobile-sync|--ms)
            open ~/Library/Application\ Support/MobileSync/Backup
        ;;
        ###   --logout   log out
        --logout)
            # killall -u $USER;
            # kill -9 `ps -Axjc | awk /loginwindow/'{print $2}'`;
            # # System Preferences -> Universal Access -> Enable access for assistive devices
            # echo a | sudo tee /var/db/.AccessibilityAPIEnabled
            # launchctl bootout user/$(id -u $USER)
            printf 'tell application "System Events"
                log out
            end tell
            ' | osascript
        ;;
        ###   --notify=STRING   display a notification
        --notify)
            shift;
            if [ "$3" ]; then
                osascript -e 'display notification "'"$1"'" with title "'"$2"'" subtitle "'"$3"'"'
            elif [ "$2" ]; then
                osascript -e 'display notification "'"$1"'" with title "'"$2"'"'
            else
                osascript -e 'display notification "'"$1"'" with title "Hi"'
            fi
        ;;
        ###   --button-wait=STRING   display a dialog with a Yes button and wait
        --button-wait)
            shift;
