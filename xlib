# Load the .*.ini config.
__load_ini () {
    [ "$1" ] || return 1;
    local line is_catch=false;
    while read line; do
        [ "$line" == "" ] && continue;
        if [ "${line/=/}" == "$line" ]; then
            [ "$line" == "[$1]" ] && is_catch=true || is_catch=false;
        elif $is_catch; then
            _map $2 --put ${line%%=*} ${line#*=} >/dev/null
        fi
    done < <(cat "$(__script_dir)"/.*.ini ~/.*.ini 2>/dev/null | awk -F \; 'gsub(/\r|\\$/, ""); gsub(/\\/, "\\\\"); {print $1}' | uniq);

