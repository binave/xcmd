### Convert audio files to FLAC
### Usage: 2flac
### Run cflac in the working directory
_x3rd_2flac () {
    local regex='alac|ape|m4a|tta|tak|wav';
    which ffmpeg >/dev/null 2>&1 || exit 1; # The ffmpeg command was not found.
    [[ $OSTYPE == darwin* ]] && {
        find -E -type f -iregex '.*\.('$regex')$' -exec ffmpeg -hide_banner -i {} -acodec flac {}.flac \; || :
    } || {
        find -type f -iregex '.*\.\('${regex//\|/\\|}'\)$' -exec ffmpeg -hide_banner -i {} -acodec flac {}.flac \; || :
    }
    return 0
}

### Play all media in a directory
### Usage: play [OPTION]... [DIRECTORY]...
### Environment: PLAY_VOLUME, PLAY_SCALE, PLAY_OPTS
_x3rd_play () {
    which ffplay >/dev/null 2>&1 || exit 1; # The ffplay command was not found.
    which xlib >/dev/null 2>&1 || exit 1; # The xlib command was not found.

    local file_list media=() maxdepth stream_specifier skip=0 ext regex;

    # Arguments.
    while [ $# -gt 0 ]; do
        case "$1" in
            ###   -d, --maxdepth=NUMBER   set the find depth, default is the maximum
            -*maxdepth | -d)
                xlib inum $2 && {
                    maxdepth="-maxdepth $2";
                    shift
                } || exit 1; # The maximum depth must be a number.
            ;;
            ###   -r, --random   play in random order
            -*random | -r)
                file_list=1;
            ;;
            ###   -a, --ast=NUMBER   select the desired audio stream
            -*ast | -a)
                # -ast stream_specifier  select the desired audio stream.
                xlib inum $2 && {
                    stream_specifier="-ast $2";
                    shift
                } || exit 1; # The audio specifier must be a number.
            ;;
            ###   -j, --skip=NUMBER   skip NUMBER files
            -*skip | -j)
                xlib inum $2 && {
                    skip=$2;
                    shift
                } || exit 1; # The skip count must be a number.
            ;;
            *)
                if [ -f "$1" -o -d "$1" ]; then
                    media[${#media[@]}]="$1"
                else
                    exit 1; # Not a path.
                fi
            ;;
        esac
        shift
    done

    [ ${#media[@]} == 0 ] && exit 1; # No media file found.

    regex='avi|divx|flv|mkv|mp4|mpg|rm|rmvb|vob|wmv|alac|ape|flac|m4a|mp3|ogg|tta|tak|wav|wma';

    [[ $OSTYPE == darwin* ]] && {
        ext='-E';
        regex='.*\.('$regex')$'
    } || regex='.*\.\('${regex//\|/\\|}'\)$'

    mkdir -p "$HOME/.playlist";

    function __playlist_index () {
        local index;
        read index < "$1.index";
        : ${index:=0};
        [ $index == $(cat "$1"[+-] | grep -c '\.') ] && {
            printf $index;
            return 0
        };
        return 1
    } 2>/dev/null;

    function __sort_play () {
        # __playlist_index "$2" || exit 1; # playlist error
        __play_ff "$1" && {
            printf "%s\n" "$1" >> "$2+";
            :
        } || printf "%s\n" "$1" >> "$2-"
    };

    function __play_title () {
        printf "\n\nProgress $1";
        shift;
        [ "$1" ] && {
            sleep 0.5;
            printf "%s\n" "Next track '$*'"
        } &
    };

    function __play_ff () {
        [ -f "$1" ] || exit 1; # File does not exist.
        case "`xlib str --lower ${1##*.}`" in
            avi|divx|flv|mkv|m2ts|mp4|mpg|rm|rmvb|vob|wmv)
                # -ch_layout stereo #ED..A... set number of audio channels (from 0 to INT_MAX) (default 0) #Convert the 5.1 track to stereo
                # -sn #disable subtitling
                ffplay -hide_banner $PLAY_OPTS $stream_specifier -ch_layout stereo -sn -vf "scale=${PLAY_SCALE:-'-1:-1'}" -autoexit -af "volume=${PLAY_VOLUME:-0.85}" "$1" || return 1
            ;;
            alac|ape|flac|m4a|mp3|ogg|tta|tak|wav|webm|wma)
                ffplay -hide_banner $PLAY_OPTS -nodisp -autoexit -af "volume=${PLAY_VOLUME:-0.15}" "$1" || return 1
            ;;
            *)
                exit 1; # Unknown suffix.
            ;;
        esac
        return 0
    };

    local i line path last_index playlist cache_line line_count;

    for path in "${media[@]}"; do
        if [ -d "$path" ]; then

            # Full path.
            play_list="$HOME/.playlist/`openssl sha256 <<< "$(cd "$path"; pwd)"`.list";

            # Random playlist.
            if [ "$file_list" ]; then
                file_list=();
                if [ -s "$play_list" ]; then
                    # Line number.
                    line_count=`grep -c '\.' "$play_list"`;
                    last_index=`__playlist_index "$play_list"` || {
                        rm -f "$play_list"[+-];
                        last_index=0
                    };
                else
                    # Random list.
                    local len cols sub ran;
                    printf '\033[?25l'; # Hide the cursor.
                    trap 'printf "\033[?25h"; exit' INT; # Show the cursor after Ctrl-C.
                    while read line; do
                        sub="${line#$path}";
                        sub="${sub#/}";
                        # `tput lines` `tput cols` = `stty size` = $LINES $COLUMNS
                        cols=${COLUMNS:-`tput cols`}; # May change during execution.
                        len=0;
                        for ((i=0; i<${#sub}; i++)); do
                            [ $((++len)) -ge $cols ] && break;
                            # [^0-z!\"#$%&\'()*+,-.\/{|\}~]
                            [[ ${sub:$i:1} == [^0-z!\"\#$%\&\'\(\)*+,-.\/{\|\}~] ]] && ((++len))
                        done
                        printf "%*s\r${sub:0:$i}\r" $cols;
                        i=${#file_list[@]};
                        [ $i -gt 1 ] && {
                            ran=$((RANDOM % $i));
                            file_list[$i]=${file_list[$ran]};
                            file_list[$ran]="$line"
                        } || file_list[$i]="$line"
                    done < <(find $ext "$path" $maxdepth -type f -iregex $regex);
                    printf '%*s\r\033[?25h' $cols;

                    [ ${#file_list[@]} == 0 ] && exit 1; # No media file found.

                    for i in `seq 0 $i`; do
                        printf "%s\n" "${file_list[$i]}"
                    done > "$play_list";

                    line_count=${#file_list[@]} last_index=0;
                    > "$play_list.index";
                fi

                i=0;
                while read line; do
                    [ $((i++)) -lt $last_index ] && continue;
                    if [ -f "$cache_line" ]; then
                        __play_title "#$((i - 1)) / $line_count, RANDOM" $line;
                        __sort_play "$cache_line" "$play_list";
                        printf "%s" $((i - 1)) > "$play_list.index";
                    fi
                    cache_line="$line"
                done < "$play_list";
                __sort_play "$cache_line" "$play_list"

                # TODO

            else
                file_list=();
                while read line; do
                    file_list[${#file_list[@]}]="$line"
                done < <(find $ext "$path" $maxdepth -type f -iregex $regex | sort);

                [ ${#file_list[@]} == 0 ] && exit 1; # No media file found.

                i=$((${#file_list[@]} - 1));
                [ $skip -gt $i ] && exit 1; # Skip is out of bounds.
                for i in `seq $skip $i`; do
                    __play_title "#$((i + 1)) / ${#file_list[@]} " "${file_list[$((i + 1))]}";
                    __play_ff "${file_list[$i]}"
                done
            fi
        elif [ -f "$path" ]; then
            __play_ff "$path"
        else
            exit 1; # Target does not exist.
        fi
    done
}

### Camera tools
### Usage: cam [OPTION]... [ARG]...
_x3rd_cam () {
    case $1 in
        ###   -l, --list   list camera devices
        --list|-l)
            which ffmpeg >/dev/null 2>&1 || exit 1; # The ffmpeg command was not found.
            local dev
            if [[ $OSTYPE == darwin* ]]; then
                [ "$2" == "-f" ] && sudo killall VDCAssistant; # Kill AppleCameraAssistant.
                dev=avfoundation
            else
                dev=x11grab
            fi
            ffmpeg -hide_banner -f $dev -list_devices true -i "" 2>&1 | grep \]
        ;;
        ###   -s, --show=ID   display the target camera
        --show|-s)
            shift;
            which ffplay >/dev/null 2>&1 || exit 1; # The ffplay command was not found.
            which xlib >/dev/null 2>&1 || exit 1; # The xlib command was not found.
            xlib inum $1 || exit 1; # Invalid first argument.
            local device_index fmt framerate video_size
            shift
            while [ "$1" ]; do
                case $1 in
                    [0-9]|[1-9][0-9])
                        device_index=$1;
                        shift
                    ;;
                    *[0-9]x[1-9]*)
                        video_size="-video_size $1";
                        shift
                    ;;
                    [1-9][0-9]*fps)
                        framerate="-framerate ${1%%[^0-9]*}";
                        shift
                    ;;
                    *)
                        exit 1; # Invalid option.
                    ;;
                esac
            done
            [[ $OSTYPE == darwin* ]] && fmt=avfoundation || fmt=x11grab;

            # Supported pixel formats:
            #     uyvy422
            #     yuyv422
            #     nv12
            #     0rgb
            #     bgr0

            # -probesize 32
            # -tune zerolatency
            # -fflags nobuffer

            ffplay -hide_banner -f $fmt $video_size $framerate -fflags nobuffer -pixel_format bgr0 -i $device_index 2>&1
            # ffplay -f avfoundation $video_size -framerate 29 -pixel_format 0rgb -i "XI100DUSB-HDMI":"XI100DUSB-HDMI Audio" 2>&1
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

### Print download URLs
### Usage: urls [OPTION]...
_x3rd_urls () {
    # https://github.com/google/omaha/blob/master/doc/ServerProtocol.md
