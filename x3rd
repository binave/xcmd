### Maven repository tools
### Usage: m2 [OPTION]...
_x3rd_m2 () {
    case $1 in
        ###   -d, --download=ARTIFACT   download ARTIFACT to the local maven repository
        --download|-d)
            shift;
            _m2_download "$@"
        ;;
        ###   -c, --trim[=PATH]   print broken files in the local maven repository
        --trim|-c)
            local _lu=0 line _hash _h;
            while read line; do
                unset _hash _h;
                case ${line##*.} in
                    lastUpdated)
                        ((_lu++));
                        rm -f "$line"
                    ;;
                    sha1|md5)
                        read -d , _hash < $line;
                        _hash=$(tr "[:upper:]" "[:lower:]" <<< "${_hash%% *}");
                        _hash=${_hash//[^0-9A-Fa-f]/};
                        _h=$(openssl ${line##*.} "${line%.*}" | awk '{for(i=1; i<=NF; i++)if($i ~ /^[0-9A-Fa-f]+$/)printf $i}' | tr "[:upper:]" "[:lower:]");
                        [ "$_hash" == "$_h" ] || \
                            printf "rm -fv ${line%.*}* # ${line##*.} $_hash, $_h\n"
                    ;;
                    *)
                        :
                    ;;
                esac
            done < <(
                find ${2:-$HOME/.m2} -type f -iname "*.lastUpdated" -o -iname "*.sha1" -o -iname "*.md5"
            )

            printf "# lastUpdated: $_lu\n"
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

_m2_download () {
    local i _ver _m2=$@;

    [ "http" != "${_m2:0:4}" -a "${_m2}" -a "${_m2/\//}" != "${_m2}" ] || exit 1; # Invalid arguments.

    # Support -np.
    while [ "/" == "${_m2:0-1}" ]; do
        # Trim: # linux:${_m2:0:-1} -> darwin:${_m2:0:${#_m2}-1}
        _m2=${_m2:0:${#_m2}-1};
    done;

    _ver=${_m2##*/};
    _m2=${_m2%/*};
    # Replace the period with '/'.
    _m2=${_m2//\./\/}/${_ver};

    # Link the target to $HOME/.m2/repository.
    ln -s $HOME/.m2/repository /tmp/maven2 2>/dev/null || {
        ps -ef | awk '/repo1.maven.org\/maven2/' >/dev/null && exit 1 # The m2 command is already running.
    };

    function __m2_get () {
        local url;
        while read url; do
            [ "/" == "${url:0-1}" ] && {
                # Is a directory.
                mkdir /tmp/maven2/${1:30}$url;
                __m2_get ${1}$url || :;
            } || {
                let ++i; # Count the downloaded files.
                printf "\nSaving to: /tmp/maven2/${1:30}$url -- ${1}$url\n\n";
                # Not a directory.
                curl ${1}$url -o /tmp/maven2/${1:30}$url
            };
        done < <(curl ${1}index.html | awk -F "a href=\"" '{printf "%s\n",$2}' | awk -F "\"" '{printf "%s\n",$1}' | grep -vE "^$|^\?|^http:\/\/")
    };

    which wget >/dev/null 2>&1 && {
        # Drop the -m and -k arguments.
        wget -r -np -nc -nH -R html -e robots=off -P /tmp \
        -U 'Mozilla/5.0 (X11; Linux x86_64; rv:31.0) Gecko/20100101 Firefox/31.0' \
        http://repo1.maven.org/maven2/${_m2}/ || :
    } || {
        which curl >/dev/null 2>&1 && {
            # Creating a directory is not supported.
            mkdir -p /tmp/maven2/${_m2};
            __m2_get http://repo1.maven.org/maven2/${_m2}/;
            printf "\nDownloaded: $i files\n"
        } || exit 1; # Neither wget nor curl was found.
    };

    # Drop the link.
    rm -f /tmp/maven2;

    return 0
}

### Virtual machine controller [macOS]
### Usage: vm {list|start}
_x3rd_vm () {
    [[ $OSTYPE == darwin* ]] || exit 1; # Only macOS (OS X) is supported.
    case $1 in
        ###   list   list virtual machines
        ""|list)
            for vn in ~/Virtual\ Machines.localized/*.vmwarevm/*.vmx; do
                [ -f "$vn" ] || continue;
                vn="${vn##*/}";
                printf "%s\n" "${vn%.*}";
            done
        ;;
        ###   start   start a virtual machine
        start)
            shift;
            [ -f "$HOME/Virtual Machines.localized/"$1".vmwarevm/"$1".vmx" ] || exit 1; # The virtual machine does not exist.
            vmrun -T fusion start ~/Virtual\ Machines.localized/"$1".vmwarevm/"$1".vmx nogui
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}


### Compress PNG images
### Usage: png [DIRECTORY] [DIRECTORY]
### Only ASCII file names are supported
_x3rd_png () {
    which pngquant >/dev/null 2>&1 || exit 1; # The pngquant command was not found.
    [ -d "$1" ] || exit 1; # Source path does not exist.
    [ "$2" ] || exit 1; # Output path not set.
    local line src="${1%/}" out="${2%/}" tag;
    while read line; do
        tag="$out/${line#$src/}";
        [ -d "${tag%/*}" ] || mkdir -p "${tag%/*}";
        pngquant --quality 70-90 --speed 1 --strip --verbose --output "$tag" "$line"
    done < <(
        find "$src" -type f -iname "*.png"
    )
}

### Convert PNG images to PDF
### Usage: pdf [DIRECTORY]...
_x3rd_pdf () {
    which convert >/dev/null 2>&1 || exit 1; # The convert command was not found.
    local i OLDPWD="$PWD";
    for i in "$@"; do
        [ -d "$i" ] || {
            printf "%s\n" "$i not a dir" >&2;
            continue
        };
        # http://www.imagemagick.org/Usage/blur/
        # http://www.imagemagick.org/Usage/resize/#resize_unsharp
        # http://www.imagemagick.org/Usage/convolve/#unsharpen

        # convert -sharpen 0x3.3 *.png -resize 48% zongzhi-3.3.pdf
        # convert *.png -filter spline -resize 48% -unsharp 0x1 zongzhi+.pdf
        cd "$i" && convert *.png -resize 620x-1 -define convolve:scale=-100,200% -morphology Convolve 'Gaussian:0x2' ../"${PWD##*/}".pdf

    done
    cd "$OLDPWD";

}

### Shell completion, auto-generated from annotations
### Usage: comp [OPTION]...
_x3rd_comp () {
    source "$(__script_dir)/comp.xlib";
    case $1 in
        ###   -b, --bash   print the bash completion script
        --bash|-b)
            shift;
            __comp_bash "$@"
        ;;
        ###   -z, --zsh   print the zsh completion script
        --zsh|-z)
            shift;
            __comp_zsh "$@"
        ;;
        ###   -f, --fish   print the fish completion script
        --fish|-f)
            shift;
            __comp_fish "$@"
        ;;
        ###   -i, --install[=SHELL]   install completion to HOME, default is the current shell
        --install|-i)
            shift;
            __comp_install "$@" || exit 1; # Completion installation failed.
        ;;
        ###   -v, --value=KIND   print the candidates of KIND
        --value|-v)
            shift;
            __comp_value "$@"
        ;;
        ###   -l, --list[={macos|linux|all}]   print the parsed completion metadata
        --list|-l)
            shift;
            __comp_scan "${1:-}" | tr ';' '\t'
        ;;
        ###   -c, --check   check annotation and print warnings
        --check|-c)
            shift;
            __comp_check || exit 1 # Annotation warning found.
        ;;
        *)
            exit 1; # Invalid option.
        ;;
    esac
}

