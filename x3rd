# Resolve the real script directory, follow symlink
__script_dir () {
    [ "$__SELF_DIR" ] && { printf "%s" "$__SELF_DIR"; return; }
    local src=$0 dir;
    while [ -L "$src" ]; do
        dir=$(cd "$(dirname "$src")" && pwd);
        src=$(readlink "$src");
        case $src in /*) :;; *) src="$dir/$src";; esac
    done
    cd "$(dirname "$src")" && pwd
}
__SELF_DIR=$(__script_dir)

