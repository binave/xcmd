# Test for a help option.
[[ ! "$1" || "$1" == "-h" || "$1" == "--help" ]] && {
    _func_annotation | sort;
    exit 0
} || [[ "$2" == "-h" || "$2" == "--help" ]] && {
    # Test for a help option.
    _func_annotation $1 || printf "\033[31mError: No function found \033[0m\n" >&2;
    exit $?
};

# Normalize [--option=value] into [--option] [value]
args=();
for i in "$@"; do
    case $i in
        -*=*) args[${#args[@]}]="${i%%=*}"; args[${#args[@]}]="${i#*=}";;
        *)    args[${#args[@]}]="$i";;
    esac
done

