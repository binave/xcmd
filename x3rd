# Print error info.
_func_err () {
    [[ "$4$6" == exit_${0##*/}* ]] && {
        # local err=`awk 'NR=='$2'{print}' "$0"`;
        local err=`sed -n $2p "$0"`
        # Print the line text after '#'.
        printf "\033[31mError:${err##*#} \033[33m($0:$2)\033[0m\n" >&2;
        exit $(($5 % 256))
    };

    # WARNING: 0 <= $? <= 255; return 256 gives $? = 0.
    [ "$4" == "return" ] && exit $(($5 % 256));

    # A command was not found: the dispatch of an unknown command, or a missing
    # external command.
    [ $1 == 127 ] && {
        [[ $4 == *'${0##*/}'* ]] && { printf "\033[31mError: No function found \033[0m\n" >&2; exit 1; };
        printf "\033[31mError: Command not found: %s \033[33m($0:$2)\033[0m\n" "$4" >&2; exit 127
    };

    exit 0
}

# Show the function info.
_func_annotation () {
    source "$(__script_dir)/comp.xlib";
    local kind cmd key text last= found=;
    local -a cmd_lines=() opt_lines=();
    if [ "$1" ]; then
        # Show one command.
        while IFS=$'\t' read -r kind cmd key text; do
            [ "$cmd" == "$1" ] || continue;
            found=true;
            case $kind in
                O) opt_lines[${#opt_lines[@]}]="$text";;
                P|Q) :;;
                *) cmd_lines[${#cmd_lines[@]}]="$text";;
            esac
        done < <(__annot_scan);
        [ "$found" ] || return 1;
        # split the command annotation around the Usage line
        local -a pre_usage=() post_usage=();
        local usage_line= seen_usage=;
        for text in "${cmd_lines[@]}"; do
            case $text in
                Usage:*)
                    seen_usage=true;
                    usage_line=$text
                ;;
                *)
                    if [ "$seen_usage" ]; then
                        post_usage[${#post_usage[@]}]="$text"
                    else
                        pre_usage[${#pre_usage[@]}]="$text"
                    fi
                ;;
            esac
        done
        [ ${#pre_usage[@]} -gt 0 ] && printf "%s\n" "${pre_usage[@]}";
        [ "$seen_usage" ] && printf "\n%s\n\n" "$usage_line";
        [ ${#post_usage[@]} -gt 0 ] && printf "%s\n" "${post_usage[@]}";
        [ ${#opt_lines[@]} -gt 0 ] && {
            [ ${#post_usage[@]} -gt 0 ] && printf "\n";
            __annot_print "${opt_lines[@]}"
        };
        if [ ${#post_usage[@]} -gt 0 ] || [ ${#opt_lines[@]} -gt 0 ] || [ ! "$seen_usage" ]; then
            printf "\n";
        fi
        return 0

    else
        # Show all commands; the first line of each command annotation is the
        # brief, with its [macOS] / [Linux] tag kept at the end of the line.
        while IFS=$'\t' read -r kind cmd key text; do
            [ "$kind" == "C" ] || continue;
            [ "$cmd" == "$last" ] && continue;
            last=$cmd;
            # Left aligned at 15 characters.
            printf "%-15s%s\n" "$cmd" "$text";
        done < <(__annot_scan)
    fi

}

# Cache and exit.
# bash >= 4.1 resets $LINENO to 1 inside an EXIT trap, so track the real line with
# a DEBUG trap there; older bash (the 3.2 shipped with macOS) reports it directly.
[ "${BASH_VERSINFO[0]}" -gt 4 -o "${BASH_VERSINFO[0]}" -eq 4 -a "${BASH_VERSINFO[1]}" -ge 1 ] && {
    set -T;
    trap 'case $LINENO in 1|"") :;; *) __err_line=$LINENO;; esac' DEBUG
};
trap '_func_err $? "${__err_line:-$LINENO}" $BASH_LINENO $BASH_COMMAND ${FUNCNAME[@]}' EXIT

